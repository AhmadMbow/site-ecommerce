# =============================================================================
# Variables d'environnement pour sadiboushop.com
# Copiez ce fichier en .env et remplissez les valeurs
# =============================================================================

# Django Secret Key (Générez une nouvelle clé unique!)
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=votre-cle-secrete-unique-et-longue

# Base de données MySQL
DB_NAME=sadiboushop_db
DB_USER=sadiboushop_user
DB_PASSWORD=votre_mot_de_passe_db
DB_HOST=localhost
DB_PORT=3306

# Configuration Email
EMAIL_HOST_USER=info@sadiboushop.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_email

# OAuth Google (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth Facebook (optionnel)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
